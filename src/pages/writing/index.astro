---
import { getLocale, translator } from "../../utils/i18n";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/layout/Container.astro";
import SectionTitle from "../../components/ui/SectionTitle.astro";
import PostCard from "../../components/writing/PostCard.astro";

const locale = getLocale(Astro.url.pathname);
const t = translator(locale);

const posts = (await getCollection(locale === "en" ? "posts-en" : "posts")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={t("Blog | Portfolio")} description={t("Notas técnicas y aprendizajes prácticos.")} image="/og/writing.png">
  <Container className="py-16 sm:py-20">
    <div class="scroll-reveal">
      <SectionTitle as="h1" title={t("Blog")} subtitle={t("Artículos técnicos enfocados en decisiones y aprendizaje real.")} />
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post, i) => (
          <div class={`scroll-reveal stagger-${(i % 6) + 1}`}>
            <PostCard post={post} />
          </div>
        ))
      }
    </div>
  </Container>
</BaseLayout>
